# Staging build settings (npm run dev:staging / npm run build:staging).
# These are the staging Supabase project's public URL and publishable
# (anon) key, the same kind of public values src/lib/supabase.js hardcodes
# for production, so this file is committed. Never put a service-role key
# or database password here.
VITE_APP_ENV=staging
VITE_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_KEY
